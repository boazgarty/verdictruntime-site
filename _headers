# Response headers. Read natively by Cloudflare Pages, and also honoured by
# Netlify. netlify.toml carries the same set for Netlify deploys.
#
# The Content-Security-Policy below is deliberately strict: this site ships no
# JavaScript at all, so scripts can be forbidden outright rather than allowed
# and then constrained. Styles come from a stylesheet file and Google Fonts,
# never from inline attributes, so 'unsafe-inline' is not needed either.

/*
  Content-Security-Policy: default-src 'none'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/styles.css
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=86400
